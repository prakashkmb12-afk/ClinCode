# ---- PostgreSQL ----
DB_HOST=postgres
DB_PORT=5432
DB_NAME=clincode
DB_USER=clincode
DB_PASS=clincode_dev_2026

# ---- Qdrant ----
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_CODES=icd_cpt_descriptions
QDRANT_COLLECTION_NOTES=note_chunks
EMBEDDING_DIM=768

# ---- MinIO ----
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=clincode
MINIO_ROOT_PASSWORD=clincode_dev_2026
MINIO_BUCKET_DOCS=clinical-documents
MINIO_SECURE=false

# ---- Redis ----
REDIS_URL=redis://redis:6379/0

# ---- MLflow ----
MLFLOW_TRACKING_URI=http://mlflow:5000

# ---- Coding behaviour ----
CODE_SET_VERSION=ICD10CM-FY2026
SUGGESTION_MIN_CONFIDENCE=0.35
MAX_SUGGESTIONS_PER_SPAN=5